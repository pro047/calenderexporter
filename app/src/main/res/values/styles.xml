<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/action_blue</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="TextAppearance.App.LargeTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Body" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.App.SectionLabel" parent="android:style/TextAppearance.Material.Subhead">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.App.Month" parent="android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Summary" parent="android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Preview" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.App.PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.App.SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/secondary_button_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.App.MonthButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/month_button_text</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
