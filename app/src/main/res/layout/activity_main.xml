<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/screenTitle"
            style="@style/TextAppearance.App.LargeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_title" />

        <TextView
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_description" />

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/month_selection" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_group_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/previousMonthButton"
                style="@style/Widget.App.MonthButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/previous_month" />

            <TextView
                android:id="@+id/monthText"
                style="@style/TextAppearance.App.Month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" />

            <Button
                android:id="@+id/nextMonthButton"
                style="@style/Widget.App.MonthButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/next_month" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/calendar_selection" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_group_surface"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/calendarHintText"
                style="@style/TextAppearance.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:text="@string/calendar_permission_hint" />

            <LinearLayout
                android:id="@+id/calendarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/actionButton"
            style="@style/Widget.App.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_permission" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/action_blue"
            android:visibility="gone" />

        <TextView
            android:id="@+id/summaryText"
            style="@style/TextAppearance.App.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/exportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/exportPlainTextButton"
                style="@style/Widget.App.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_plain_text" />

            <Button
                android:id="@+id/exportTextFileButton"
                style="@style/Widget.App.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/export_text_file" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/preview_title" />

        <TextView
            android:id="@+id/resultText"
            style="@style/TextAppearance.App.Preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_group_surface"
            android:gravity="top|start"
            android:minHeight="128dp"
            android:padding="16dp"
            android:text="@string/preview_hint"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
